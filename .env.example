DATABASE_URL=postgresql+asyncpg://support:support@db:5432/support
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=support
# Generate independent random tokens (32+ characters). Never commit .env.
ADMIN_API_KEY=replace-with-random-admin-token-32-chars
BOT_API_KEY=replace-with-random-bot-token-32-chars
# Map API keys to stable operator identities; JSON object.
OPERATOR_KEYS={"replace-with-random-operator-token-32-chars":"operator-1"}
BOT_TOKEN=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.35
BACKEND_URL=http://backend:8000
BACKEND_PORT=8000
LOG_LEVEL=INFO
